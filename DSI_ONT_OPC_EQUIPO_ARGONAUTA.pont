(defclass Mortal
	(is-a Ser)
	(role abstract)
	(multislot tieneElEnojoDe
		(type INSTANCE)
;+		(allowed-classes Dios)
		(create-accessor read-write))
	(multislot tieneElFavorDe
;+		(comment "Un mortal tiene el favor de un dios")
		(type INSTANCE)
;+		(allowed-classes Dios)
		(create-accessor read-write))
	(single-slot estaVivo
;+		(comment "True si el mortal esta vivo, falso si no")
		(type SYMBOL)
		(allowed-values FALSE TRUE)
		(default TRUE)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Semidios
	(is-a Mortal)
	(role concrete))

(defclass Criatura
	(is-a Mortal)
	(role abstract))

(defclass Gorgona
