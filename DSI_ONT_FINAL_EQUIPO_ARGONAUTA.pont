(defclass Ser "Clase abstracta que representa a los distintos seres o personajes que son importantes en un mito"
	(is-a %3ASYSTEM-CLASS)
	(role abstract)
	(single-slot estaLibre
;+		(comment "Relacion: True si un ser esta libre, false si esta apresado")
		(type SYMBOL)
		(allowed-values FALSE TRUE)
		(default TRUE)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(multislot mataA
;+		(comment "Relacion: Un ser mata a un mortal")
		(type INSTANCE)
;+		(allowed-classes Mortal)
		(create-accessor read-write))
	(multislot tieneElEnojoDe
;+		(comment "Relacion: Un ser tiene el enojo de otro")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(create-accessor read-write))
	(multislot liberaA
;+		(comment "Relacion: Un ser libera a otro")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(create-accessor read-write))
	(multislot localizaA
;+		(comment "Relacion: Un ser localiza a otro")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(create-accessor read-write))
	(multislot esHijoDe
;+		(comment "Relacion: Un ser es hijo de otro (en particular, un semidios es hijo de un dios)")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(cardinality 0 2)
		(create-accessor read-write))
	(single-slot nombre
;+		(comment "Nombre de la instancia")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(multislot encierraA
;+		(comment "Relacion: Un ser encierra a otro")
		(type INSTANCE)
;+		(allowed-classes Ser)
		(create-accessor read-write))
	(single-slot apresadoPor
;+		(comment "Relacion: Un ser esta apresado por otro")
		(type INSTANCE)
;+		(allowed-classes Ser)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(single-slot estaEn
;+		(comment "Relacion: Un ser se encuentra en un lugar")
		(type INSTANCE)
;+		(allowed-classes Lugar)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(multislot poseeObjeto
;+		(comment "Relacion: Un ser posee un objeto")
		(type INSTANCE)
;+		(allowed-classes Objeto)
		(create-accessor read-write)))

(defclass Mortal "Clase abstracta que representa a los personajes de un mito que se consideran mortales (pueden morir)"
	(is-a Ser)
	(role abstract)
	(single-slot esHeroe
;+		(comment "Si true, entonces el mortal es heroe (alguien con logros extraordinarios en un mito). En otro caso, no es heroe.")
		(type SYMBOL)
		(allowed-values FALSE TRUE)
		(default FALSE)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(multislot tieneElFavorDe
;+		(comment "Relacion: Un mortal tiene el favor de un dios")
		(type INSTANCE)
;+		(allowed-classes Dios)
		(create-accessor read-write))
	(single-slot estaVivo
;+		(comment "True si el mortal esta vivo, falso si no")
		(type SYMBOL)
		(allowed-values FALSE TRUE)
		(default TRUE)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Semidios "Clase que representa a los hijos de un Dios y un Mortal"
	(is-a Mortal)
	(role concrete))

(defclass Criatura "Clase abstracta que representa a las distintas criaturas que pueden participar en un mito"
	(is-a Mortal)
	(role abstract))

(defclass Gorgona "Clase que representa a las Gorgonas (por ejemplo, Medusa)"
	(is-a Criatura)
	(role concrete))

(defclass CriaturaMarina "Clase que representa a las Criaturas marinas (por ejemplo, Ceto)"
	(is-a Criatura)
	(role concrete))

(defclass Minotauro "Clase que representa a los Minotauros (como el del mito del laberinto de Creta)"
	(is-a Criatura)
	(role concrete))

(defclass Humano "Clase que representa a los Mortales puros, que no son hijos de Dioses"
	(is-a Mortal)
	(role concrete))

(defclass Inmortal "Clase abstracta que representa a los personajes de un mito que se consideran inmortales (no pueden morir)"
	(is-a Ser)
	(role abstract))

(defclass Dios "Clase que representa a los dioses importantes de la mitologia griega y que pueden participar en un mito (por ejemplo, Zeus y Poseidon)"
	(is-a Inmortal)
	(role concrete)
	(single-slot tituloDivino
;+		(comment "De que es un dios")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass DiosMenor "Clase abstracta que representa a seres divinos de menor rango que otros dioses como Zeus o Poseidon"
	(is-a Inmortal)
	(role abstract))

(defclass Graya "Clase que representa a las Grayas (que son tres diosas menores)"
	(is-a DiosMenor)
	(role concrete))

(defclass Ninfa "Clase que representa a las ninfas, espiritus de la naturaleza que se consideran diosas menores en la mitologia griega"
	(is-a DiosMenor)
	(role concrete))

(defclass Objeto "Clase abstracta que representa los distintos objetos que juegan un papel importante en un mito"
	(is-a %3ASYSTEM-CLASS)
	(role abstract)
	(single-slot otorgaCapacidad
;+		(comment "Un objeto otorga una capacidad")
		(type INSTANCE)
;+		(allowed-classes Capacidad)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(single-slot nombre
;+		(comment "Nombre de la instancia")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Arma "Clase que representa a los objetos que se reconocen como armas (por ejemplo, una espada)"
	(is-a Objeto)
	(role concrete))

(defclass ObjetoMagico "Clase que representa objetos de naturaleza magica o sobrenatural, pero que no son armas per se (por ejemplo, las sandalias aladas)"
	(is-a Objeto)
	(role concrete))

(defclass Capacidad "Clase que representa las capacidades especiales de un ser (por ejemplo, volar)"
	(is-a %3ASYSTEM-CLASS)
	(role concrete)
	(single-slot nombre
;+		(comment "Nombre de la instancia")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Lugar "Clase que representa las distintas localizaciones que puede haber en un mito"
	(is-a %3ASYSTEM-CLASS)
	(role concrete)
	(single-slot nombre
;+		(comment "Nombre de la instancia")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write)))