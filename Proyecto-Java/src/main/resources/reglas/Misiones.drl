package reglas

//list any import classes here.
import io.Pregunta;
import modelo.*;
import relaciones.*;

global io.Escritor escritor;

// REGLA 1: MISION DE LIBERAR A UN PRESO LOGRADA
rule "Respuesta positiva a mision liberar"
    agenda-group "Resultados"
when
    Pregunta(accion == "liberar", $heroe : sujeto, $objetivo : objetivo)
    $preso : Ser(nombre == $objetivo)
    Libera(liberador == $heroe, preso == $preso)
then
    escritor.escribirResultado("Si, " + $heroe + " puede liberar a " + $preso + ".");
end

// REGLA 2: MISION DE LIBERAR A UN PRESO FALLIDA
rule "Respuesta negativa a mision liberar"
    agenda-group "Resultados"
when
    Pregunta(accion == "liberar", $heroe : sujeto, $objetivo : objetivo)
    $preso : Ser(nombre == $objetivo)
    not Libera(liberador == $heroe, preso == $preso)
then
    escritor.escribirResultado("No, " + $heroe + " no ha podido liberar a " + $preso + ".");
end

// REGLA 3: MISION DE MATAR A UN ENEMIGO LOGRADA
rule "Respuesta positiva a mision de matar"
	agenda-group "Resultados"
when
	Pregunta(accion == "matar", $heroe : sujeto, $objetivo : objetivo)
	$asesinado : Ser(nombre == $objetivo)
	Mata(asesino == $heroe, asesinado == $asesinado)
then
	escritor.escribirResultado("Si, " + $heroe + " puede matar a " + $asesinado + ".");
end

// REGLA 4: MISION DE MATAR A UN ENEMIGO FALLIDA
rule "Respuesta negativa a mision de matar"
	agenda-group "Resultados"
when
	Pregunta(accion == "matar", $heroe : sujeto, $objetivo : objetivo)
	$asesinado : Ser(nombre == $objetivo)
	not Mata(asesino == $heroe, asesinado == $asesinado)
then
	escritor.escribirResultado("No, " + $heroe + " no ha podido matar a " + $asesinado + ".");
end


 // REGLA 5: MISION DE APRESAR LOGRADA
rule "Respuesta positiva a mision apresar"
    agenda-group "Resultados"
when
    Pregunta(accion == "apresar", $captor : sujeto, $objetivo : objetivo)
    $preso : Ser(nombre == $objetivo)
    Apresa(captor == $captor, preso == $preso)
then
    escritor.escribirResultado("Si, " + $captor + " tiene apresado a " + $preso + ".");
end

// REGLA 6: MISION DE APRESAR FALLIDA
rule "Respuesta negativa a mision apresar"
    agenda-group "Resultados"
when
    Pregunta(accion == "apresar", $captor : sujeto, $objetivo : objetivo)
    $preso : Ser(nombre == $objetivo)
    not Apresa(captor == $captor, preso == $preso)
then
    escritor.escribirResultado("No, " + $captor + " no tiene apresado a " + $preso + ".");
end

// REGLA 7: MISION DE OBTENER OBJETO LOGRADA
rule "Respuesta positiva a mision obtener objeto"
    agenda-group "Resultados"
when
    Pregunta(accion == "obtener", $personaje : sujeto, $objetivo : objetivo)
    $objeto : Objeto(nombre == $objetivo)
    PoseeObjeto(ser == $personaje, objeto == $objeto)
then
    escritor.escribirResultado("Si, " + $personaje + " ha conseguido " + $objeto + ".");
end

// REGLA 8: MISION DE OBTENER OBJETO FALLIDA
rule "Respuesta negativa a mision obtener objeto"
    agenda-group "Resultados"
when
    Pregunta(accion == "obtener", $personaje : sujeto, $objetivo : objetivo)
    $objeto : Objeto(nombre == $objetivo)
    not PoseeObjeto(ser == $personaje, objeto == $objeto)
then
    escritor.escribirResultado("No, " + $personaje + " no ha conseguido " + $objeto + ".");
end

// REGLA 9: MISION DE CONSEGUIR CAPACIDAD LOGRADA
rule "Respuesta positiva a mision conseguir capacidad"
    agenda-group "Resultados"
when
    Pregunta(accion == "capacidad", $personaje : sujeto, $objetivo : objetivo)
    $capacidad : Capacidad(nombre == $objetivo)
    TieneCapacidad(ser == $personaje, capacidad == $capacidad)
then
    escritor.escribirResultado("Si, " + $personaje + " tiene la capacidad " + $capacidad + ".");
end

// REGLA 10: MISION DE CONSEGUIR CAPACIDAD FALLIDA
rule "Respuesta negativa a mision conseguir capacidad"
    agenda-group "Resultados"
when
    Pregunta(accion == "capacidad", $personaje : sujeto, $objetivo : objetivo)
    $capacidad : Capacidad(nombre == $objetivo)
    not TieneCapacidad(ser == $personaje, capacidad == $capacidad)
then
    escritor.escribirResultado("No, " + $personaje + " no tiene la capacidad " + $capacidad + ".");
end
