package reglas;

import modelo.*;
import relaciones.*;
import io.Escritor;

//variable global escritor (para escribir en fichero respuesta)
global io.Escritor escritor;

rule "Dios transfiere objeto a quien tenga su favor"
    agenda-group "Historias"
when
    $f  : TieneFavor($m : mortal, $d : Dios)
    $dObj : PoseeObjeto(ser == $d, $o : objeto)
    not  PoseeObjeto(ser == $m, objeto == $o)
then
    insert(new PoseeObjeto($m, $o));
    escritor.escribirLinea($m.getNombre() + " obtiene " + $o.getNombre() + " debido a tener el favor de " + $d.getNombre()+".");
    delete($dObj);
end