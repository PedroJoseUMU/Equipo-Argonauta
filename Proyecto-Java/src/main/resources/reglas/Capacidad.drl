package reglas

//list any import classes here.
import modelo.*;
import relaciones.*;
rule "Heroe obtiene la capacidad de su objeto"
agenda-group "Historias"
when
    $m : Mortal(esHeroe == true)
    PoseeObjeto(ser == $m, $o : objeto)
    OtorgaCapacidad(objeto == $o, $c : capacidad)
    not TieneCapacidad(ser == $m, capacidad == $c)
then
    insert(new TieneCapacidad($m, $c));
    System.out.println($m + " obtiene la capacidad " + $c + " debido a tener " + $o);
end
