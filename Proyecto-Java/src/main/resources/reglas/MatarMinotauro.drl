package reglas

//list any import classes here.
import modelo.*;
import relaciones.*;
import io.Escritor;

global io.Escritor escritor;

rule "Teseo mata al Minotauro con un arma que corta"
    agenda-group "Historias"
when
	$laberinto : Lugar(nombre == "Laberinto")
    $heroe : Semidios(esHeroe == true, estaVivo == true, estaLibre == true)
    $minot : Minotauro(estaVivo == true)
    EstaEn(ser == $heroe, lugar == $laberinto)
    EstaEn(ser == $minot, lugar == $laberinto)
    $cor : Capacidad(nombre == "Cortar")
    TieneCapacidad(ser == $heroe, capacidad == $cor)
    not Mata(asesinado == $minot)
then
    insert(new Mata($heroe, $minot));
    escritor.escribirLinea($heroe + " mata a " + $minot + " debido a tener la capacidad " +$cor+".");
end

rule "Heracles mata al Minotauro con fuerza"
    agenda-group "Historias"
when
	$laberinto : Lugar(nombre == "Laberinto")
    $heroe : Semidios(esHeroe == true, estaVivo == true, estaLibre == true)
    $minot : Minotauro(estaVivo == true)
    EstaEn(ser == $heroe, lugar == $laberinto)
    EstaEn(ser == $minot, lugar == $laberinto)
    $fue : Capacidad(nombre == "Fuerza")
    TieneCapacidad(ser == $heroe, capacidad == $fue)
    not Mata(asesinado == $minot)
then
    insert(new Mata($heroe, $minot));
    escritor.escribirLinea($heroe + " mata a " + $minot + " debido a tener la capacidad " +$fue+".");
end

rule "Minos se enoja con Dedalo si matan al Minotauro"
    agenda-group "Historias"
when
    $minot : Minotauro(estaVivo == false)
    $minos : Humano(nombre == "Minos")
    $dedalo : Humano(nombre == "Dedalo")
    Mata(asesinado == $minot)
    not TieneEnojo(ser == $dedalo, enojado == $minos)
then
    insert(new TieneEnojo($dedalo, $minos));
    escritor.escribirLinea($minos+" se enoja con "+$dedalo+ " debido a la muerte de "+$minot+".");
end

rule "Minos enojado con un padre lo esta con su hijo"
    agenda-group "Historias"
when
    $minos : Humano(nombre == "Minos")
    TieneEnojo($padre : ser, enojado == $minos)
    HijoDe($hijo : hijo, padre == $padre)
    not TieneEnojo(ser == $hijo, enojado == $minos)
then
    insert(new TieneEnojo($hijo, $minos));
    escritor.escribirLinea($minos+" se enoja con " + $hijo + " debido a su enojo con " + $padre+".");
end

rule "Dédalo repara las alas y construye las suyas"
    agenda-group "Historias"
when
	$laberinto : Lugar(nombre == "Laberinto")
    $dedalo : Humano(nombre == "Dedalo", estaVivo == true)
    EstaEn(ser == $dedalo, lugar == $laberinto)
    $cera : Objeto(nombre == "Cera de Abejas")
    $plumas : Objeto(nombre == "Plumas")
    PoseeObjeto(ser == $dedalo, objeto == $cera)
    PoseeObjeto(ser == $dedalo, objeto == $plumas)
    $alasI : Objeto(nombre == "Alas de Icaro")
    $alasD : Objeto(nombre == "Alas de Dedalo")
    $vuelo : Capacidad(nombre == "Vuelo")
    not OtorgaCapacidad(objeto == $alasD, capacidad == $vuelo)
then
	insert(new OtorgaCapacidad($alasI, $vuelo));
    insert(new OtorgaCapacidad($alasD, $vuelo));
    insert(new PoseeObjeto($dedalo, $alasD));
    escritor.escribirLinea($dedalo+" construye las alas con "+ $cera+ " y " + $plumas +".");

end
