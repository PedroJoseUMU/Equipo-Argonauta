
package reglas;

import modelo.*;
import relaciones.*;

global io.Escritor escritor;

// REGLA 1: UN HEROE LOCALIZA A LAS GRAYAS
rule "Heroe localiza a las Grayas"
    agenda-group "Historias"
when
    $heroe : Mortal(estaVivo == true, estaLibre == true, esHeroe == true)
    $atenea : Dios(nombre == "Atenea")
    $hermes : Dios(nombre == "Hermes")
    TieneFavor(mortal == $heroe, dios == $atenea)
    TieneFavor(mortal == $heroe, dios == $hermes)
    $grayas : Graya(nombre == "Grayas")
    not Localiza(buscador == $heroe, localizado == $grayas)
then
    insert(new Localiza($heroe, $grayas));
    escritor.escribirLinea($heroe + " localiza a las Grayas gracias a Atenea y Hermes.");
end

// REGLA 2: LAS GRAYAS REVELAN AL HEROE DONDE ESTAN LAS NINFAS
rule "Heroe localiza a las Ninfas al devolver el ojo"
    agenda-group "Historias"
when
    $heroe : Mortal(estaVivo == true, estaLibre == true, esHeroe == true)
    $grayas : Graya(nombre == "Grayas")
    Localiza(buscador == $heroe, localizado == $grayas)
    $ojo : Objeto(nombre == "Ojo de las Grayas")
    $posesionOjo : PoseeObjeto(ser == $heroe, objeto == $ojo)
    $ninfas : Ninfa(nombre == "Ninfas")
    not Localiza(buscador == $heroe, localizado == $ninfas)
then
    delete($posesionOjo);
    insert(new PoseeObjeto($grayas, $ojo));
    insert(new Localiza($heroe, $ninfas));
    escritor.escribirLinea($heroe + " devuelve el Ojo de las Grayas y localiza a las Ninfas.");
end

// REGLA 3: UN HEROE LOCALIZA A MEDUSA
rule "Heroe localiza a Medusa"
    agenda-group "Historias"
when
    $heroe : Mortal(estaVivo == true, estaLibre == true, esHeroe == true)
    $ninfas : Ninfa(nombre == "Ninfas")
    Localiza(buscador == $heroe, localizado == $ninfas)
    $vuelo : Capacidad(nombre == "Vuelo")
    TieneCapacidad(ser == $heroe, capacidad == $vuelo)
    $medusa : Gorgona(nombre == "Medusa", estaVivo == true)
    not Localiza(buscador == $heroe, localizado == $medusa)
then
    insert(new Localiza($heroe, $medusa));
    escritor.escribirLinea($heroe + " localiza a Medusa gracias a las Ninfas y a su capacidad de vuelo.");
end

// REGLA 4: UN HEROE CON EL HILO LOCALIZA A UN PRESO EN EL LABERINTO
rule "Heroe localiza a un preso en el laberinto"
    agenda-group "Historias"
when
    $laberinto : Lugar(nombre == "Laberinto")
    $heroe : Mortal(estaVivo == true, estaLibre == true, esHeroe == true)
    EstaEn(ser == $heroe, lugar == $laberinto)
    PoseeObjeto(ser == $heroe, objeto.nombre == "Hilo de Ariadna")
    $preso : Mortal(this != $heroe, estaVivo == true, estaLibre == false)
    EstaEn(ser == $preso, lugar == $laberinto)
    $minotauro : Minotauro(estaVivo == true)
    Apresa(captor == $minotauro, preso == $preso)
    not Localiza(buscador == $heroe, localizado == $preso)
then
    insert(new Localiza($heroe, $preso));
    escritor.escribirLinea($heroe + " localiza a " + $preso + " gracias al Hilo de Ariadna.");
end

