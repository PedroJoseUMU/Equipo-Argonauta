package reglas;

import modelo.*;
import relaciones.*;
import io.Escritor;

//variable global escritor (para escribir en fichero respuesta)
global io.Escritor escritor;

rule "Objeto Magico otorga capacidad a su poseedor"
    agenda-group "Historias"
when
    $m : Mortal()
    $po  : PoseeObjeto(ser == $m, $o : objeto)
    $oc  : OtorgaCapacidad(objeto == $o)
    not  TieneCapacidad(ser == $m, capacidad == $oc.capacidad)
then
    insert(new TieneCapacidad($m, $oc.getCapacidad()));
    escritor.escribirLinea($m.getNombre()+ " obtiene la capacidad " + $oc.getCapacidad()+ " debido a tener " + $o.getNombre()+".");
end
